@{
	ViewData["Title"] = "Purchase";
	
	var canAdd = User.HasPermission(Permissions.Purchase.Add);
	var canView = User.HasPermission(Permissions.Purchase.View);
	var canEdit = User.HasPermission(Permissions.Purchase.Edit);
	var canDelete = User.HasPermission(Permissions.Purchase.Delete);
	var canAction = canView || canEdit || canDelete;
	
}

<div class="page-title">
	<div class="row align-items-center">
		<div class="col-sm-4">
			<h2 class="page-title-text d-inline-block">@ViewData["Title"]</h2>
			<div class="breadcrumbs d-inline-block">
				<ul>
					<li><a href="/">Dashboard</a></li>
					<li>@ViewData["Title"]</li>
				</ul>
			</div>
		</div>
		<div class="col-sm-8 text-right">
			@if (canAdd)
			{
				<a class="btn btn-primary btn-sm" asp-controller="Purchase" asp-action="Add">
					<i class="las la-plus pr-2"></i> New Purchase
				</a>
			}
		</div>
	</div>
</div>

<div class="panel panel-default">
	<div class="panel-body">
		<div class="table-responsive hide_id">
			<table class="table table-middle table-bordered table-striped datatable-table-custom">
				<thead>
					<tr>
						<th>#</th>
						<th>Supplier Name</th>
						<th>Sub Total</th>
						<th>Tax</th>
						<th>Discount</th>
						<th>Amount</th>
						<th>Purchase Date</th>
						@if (canAction)
						{
							<th class="action-th"></th>
						}
					</tr>
				</thead>
				<tbody></tbody>
				<tfoot>
					<tr>
						<th></th>
						<th></th>
						<th></th>
						<th></th>
						<th></th>
						<th></th>
						<th></th>
						@if (canAction)
						{
							<th></th>
						}
					</tr>
				</tfoot>
			</table>
		</div>
	</div>
</div>

@if (canDelete)
{
	<!-- DELETE MODAL -->
	<div class="modal fade" id="delete-card" role="dialog">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">Delete Purchase</h5>
					<button type="button" class="close" data-dismiss="modal" aria-label="Close">
						<span aria-hidden="true">&times;</span>
					</button>
				</div>
				<form asp-controller="Purchase" asp-action="Delete" method="post">
					@Html.AntiForgeryToken()
					<div class="modal-body">
						<p class="m-0">Are you sure you want to delete this purchase? All associated batches will also be deleted.</p>
						<div class="delete-card-button">
							<input type="hidden" name="id" class="delete-id">
						</div>
					</div>
					<div class="modal-footer text-center">
						<button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
						<button type="submit" class="btn btn-danger">Delete</button>
					</div>
				</form>
			</div>
		</div>
	</div>
}

@section Scripts {
	<script type="text/javascript" src="~/js/purchase_list.js"></script>
}
