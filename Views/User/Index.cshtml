@model IEnumerable<PharmaPOS_MVC.Models.UserListViewModel>
@{
	ViewData["Title"] = "Users";
	
	var canAdd = User.HasPermission(Permissions.User.Add);
	var canEdit = User.HasPermission(Permissions.User.Edit);
	var canDelete = User.HasPermission(Permissions.User.Delete);
	var canAction = canEdit || canDelete;
	
}

<div class="page-title">
	<div class="row align-items-center">
		<div class="col-sm-4">
			<h2 class="page-title-text d-inline-block">@ViewData["Title"]</h2>
			<div class="breadcrumbs d-inline-block">
				<ul>
					<li><a href="/">Dashboard</a></li>
					<li>@ViewData["Title"]</li>
				</ul>
			</div>
		</div>
		<div class="col-sm-8 text-right">
			@if (canAdd)
			{
				<a asp-controller="User" asp-action="Add" class="btn btn-primary btn-sm">
					<i class="las la-plus pr-2"></i> New User
				</a>
			}
		</div>
	</div>
</div>

<div class="panel panel-default">
	<div class="panel-body">
		<div class="table-responsive">
			<table class="table table-middle table-bordered table-striped datatable-table">
				<thead>
					<tr>
						<th>#</th>
						<th>Person Info</th>
						<th>User Name</th>
						<th>User Role</th>
						<th>Status</th>
						<th>Created Date</th>
						@if (canAction)
						{
							<th></th>
						}
					</tr>
				</thead>
				<tbody>
					@{ var index = 1; }
					@foreach (var value in Model)
					{
						<tr>
							<td>@index</td>
							<td>
								<p class="text-primary m-0">@value.FullName</p>
								<p class="m-0">@value.Email</p>
								<p class="m-0">@value.Mobile</p>
							</td>
							<td>@value.UserName</td>
							<td>@value.Role</td>
							<td class="user-status">
								<span class="label @value.Status.GetCssClass()">@value.Status</span>
							</td>
							<td>@value.CreatedDate</td>
							@if (canAction)
							{
								<td class="table-action">
									@if (value.Role != Roles.Admin)
									{
										@if (canEdit)
										{
											<a asp-controller="User" asp-action="Edit" asp-route-id="@value.Id" class="text-primary edit" data-toggle="tooltip" title="Edit">
												<i class="las la-edit"></i>
											</a>
										}

										@if (canDelete)
										{
											<a class="table-delete text-danger delete" data-toggle="tooltip" title="Delete">
												<i class="las la-trash-alt"></i><input type="hidden" value="@value.Id">
											</a>
										}
									}
								</td>
							}
						</tr>
						index++;
					}
				</tbody>
			</table>
		</div>
	</div>
</div>

@if (canDelete)
{
	<!-- DELETE MODAL -->
	<div class="modal fade" id="delete-card" role="dialog">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">Delete User</h5>
					<button type="button" class="close" data-dismiss="modal" aria-label="Close">
						<span aria-hidden="true">&times;</span>
					</button>
				</div>
				<form asp-controller="User" asp-action="Delete" method="post">
					@Html.AntiForgeryToken()
					<div class="modal-body">
						<p class="m-0">Are you sure you want to delete this user?</p>
						<div class="delete-card-button">
							<input type="hidden" name="id" class="delete-id">
						</div>
					</div>
					<div class="modal-footer text-center">
						<button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
						<button type="submit" class="btn btn-danger">Delete</button>
					</div>
				</form>
			</div>
		</div>
	</div>
}
