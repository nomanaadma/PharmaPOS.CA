@model IEnumerable<PharmaPOS_MVC.Models.CustomerViewModel>
@{
	const string pageTitle = "Customers";
	ViewData["Title"] = pageTitle;
	
	var canAdd = User.HasPermission(Permissions.Customer.Add);
	var canView = User.HasPermission(Permissions.Customer.View);
	var canEdit = User.HasPermission(Permissions.Customer.Edit);
	var canDelete = User.HasPermission(Permissions.Customer.Delete);
	var canAction = canView || canEdit || canDelete;
}

<div class="page-title">
	<div class="row align-items-center">
		<div class="col-sm-4">
			<h2 class="page-title-text d-inline-block">@ViewData["Title"]</h2>
			<partial name="Partials/_Breadcrumb" model="new BreadcrumbItem[] { 
				new(pageTitle) 
			}" />
		</div>
		<div class="col-sm-8 text-right">
			@if (canAdd)
			{
				<a class="btn btn-primary btn-sm" asp-controller="Customer" asp-action="Add">
					<i class="las la-plus pr-2"></i> New Customer
				</a>
			}
		</div>
	</div>
</div>

<div class="panel panel-default">
	<div class="panel-body">
		<div class="table-responsive">
			<table class="table table-middle table-bordered table-striped datatable-table">
				<thead>
					<tr class="table-heading">
						<th>#</th>
						<th>Customer Info</th>
						<th>Gender</th>
						<th>Email</th>
						<th>Number</th>
						<th>Status</th>
						<th>Created Date</th>
						@if (canAction)
						{
							<th></th>
						}
					</tr>
				</thead>
				<tbody>
					@{ var index = 1; }
					@foreach (var value in Model)
					{
						<tr>
							<td>@index</td>
							<td>
								<p class="m-0 text-primary">@value.FirstName @value.LastName</p>
							</td>
							<td>@value.Gender</td>
							<td>@value.Email</td>
							<td>@value.Mobile</td>
							<td>
								<span class="label @value.Status.GetCssClass()">@value.Status</span>
							</td>
							<td>@value.CreatedDate?.Format()</td>
							@if (canAction)
							{
								<td class="table-action">

									@if (canView || canEdit)
									{
										<div class="dropdown d-inline-block">
											<a class="text-primary edit dropdown-toggle" data-toggle="dropdown"><i class="las la-ellipsis-h"></i></a>
											<ul class="dropdown-menu dropdown-menu-right">
												@if (canView)
												{
													<li>
														<a asp-controller="Customer" asp-action="View" asp-route-id="@value.Id"><i class="las la-laptop pr-2"></i>View</a>
													</li>
												}
												@if (canEdit)
												{
													<li>
														<a 
															asp-controller="Customer"
															asp-action="Edit"
															asp-route-id="@value.Id"
														><i class="las la-edit pr-2"></i>Edit</a>
													</li>
												}
											</ul>
										</div>
									}

									@if (canDelete)
									{
										<a class="table-delete text-danger delete" data-toggle="tooltip" title="Delete"><i class="las la-trash-alt"></i><input type="hidden" value="@value.Id"></a>
									}

								</td>
							}
						</tr>
						index++;
					}
				</tbody>
			</table>
		</div>
	</div>
</div>

@if (canDelete)
{
<!-- DELETE MODAL -->
<div class="modal fade" id="delete-card" role="dialog">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Delete Customer</h5>
				<button type="button" class="close" data-dismiss="modal" aria-label="Close">
					<span aria-hidden="true">&times;</span>
				</button>
			</div>
			<form asp-controller="Customer" asp-action="Delete" method="post">
				@Html.AntiForgeryToken()
				<div class="modal-body">
					<p class="m-0">Are you sure you want to delete this customer?</p>
					<div class="delete-card-button">
						<input type="hidden" name="id" class="delete-id">
					</div>
				</div>
				<div class="modal-footer text-center">
					<button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
					<button type="submit" class="btn btn-danger">Delete</button>
				</div>
			</form>
		</div>
	</div>
</div>
}
