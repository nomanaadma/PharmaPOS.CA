@using PharmaPOS_MVC.Domain.Enums
@model PharmaPOS_MVC.Models.CustomerViewModel
@{
	var isEdit = Model?.Id.HasValue ?? false;
	var pageType = isEdit ? "Edit" : "Add";
	
	ViewData["Title"] = pageType + " Customer";
}

<div class="page-title">
	<div class="row align-items-center">
		<div class="col-sm-12">
			<h2 class="page-title-text d-inline-block">@ViewData["Title"]</h2>
			<div class="breadcrumbs d-inline-block">
				<ul>
					<li><a href="/">Dashboard</a></li>
					<li><a asp-controller="Customer" asp-action="Index">Customers</a></li>
					<li>@ViewData["Title"]</li>
				</ul>
			</div>
		</div>
	</div>
</div>

<form asp-action="@pageType" method="post">
	@Html.AntiForgeryToken()
	@if (isEdit)
	{
		<input type="hidden" asp-for="Id" />
	}
	<div class="panel panel-default">
		<div class="panel-body">
			<div class="row">
				<div class="col-md-3">
					<div class="form-group">
						<label>First Name <span class="form-required">*</span></label>
						<div class="input-group">
							<div class="input-group-prepend">
								<span class="input-group-text"><i class="las la-user"></i></span>
							</div>
							<input type="text" asp-for="FirstName" class="form-control" placeholder="Enter First Name . . . ">
						</div>
						<span asp-validation-for="FirstName" class="text-danger"></span>
					</div>
				</div>
				<div class="col-md-3">
					<div class="form-group">
						<label>Last Name <span class="form-required">*</span></label>
						<div class="input-group">
							<div class="input-group-prepend">
								<span class="input-group-text"><i class="las la-user"></i></span>
							</div>
							<input type="text" asp-for="LastName" class="form-control" placeholder="Enter Last Name . . . ">
						</div>
						<span asp-validation-for="LastName" class="text-danger"></span>
					</div>
				</div>
				<div class="col-md-6">
					<div class="form-group">
						<label>Email Address <span class="form-required">*</span></label>
						<div class="input-group">
							<div class="input-group-prepend">
								<span class="input-group-text"><i class="las la-envelope"></i></span>
							</div>
							<input type="email" asp-for="Email" class="form-control" placeholder="Enter Email Address . . . ">
						</div>
						<span asp-validation-for="Email" class="text-danger"></span>
					</div>
				</div>
				<div class="col-md-6">
					<div class="form-group">
						<label>Mobile Number <span class="form-required">*</span></label>
						<div class="input-group">
							<div class="input-group-prepend">
								<span class="input-group-text"><i class="las la-mobile"></i></span>
							</div>
							<input type="text" asp-for="Mobile" class="form-control" placeholder="Enter Mobile Number . . . ">
						</div>
						<span asp-validation-for="Mobile" class="text-danger"></span>
					</div>
				</div>
				<div class="col-md-6">
					<div class="row">
						<div class="col-md-6">
							<div class="form-group">
								<label>Gender <span class="form-required">*</span></label>
								<div class="input-group">
									<div class="input-group-prepend">
										<span class="input-group-text"><i class="las la-genderless"></i></span>
									</div>
									<select asp-for="Gender" class="custom-select" asp-items="Html.GetEnumSelectList<Gender>()"></select>
								</div>
								<span asp-validation-for="Gender" class="text-danger"></span>
							</div>
						</div>
						@if (isEdit)
						{
							<div class="col-md-6">
								<div class="form-group">
									<label>Status <span class="form-required">*</span></label>
									<div class="input-group">
										<div class="input-group-prepend">
											<span class="input-group-text"><i class="las la-check-square"></i></span>
										</div>
										<select asp-for="Status" class="custom-select" asp-items="Html.GetEnumSelectList<Status>()">
										</select>
									</div>
									<span asp-validation-for="Status" class="text-danger"></span>
								</div>
							</div>
						}
					</div>
				</div>
			</div>
		</div>
		<div class="panel-footer text-center">
			<button type="submit" class="btn btn-primary"><i class="las la-save pr-2"></i> Save</button>
			<a asp-controller="Customer" asp-action="Index" class="btn btn-secondary"><i class="las la-times pr-2"></i> Cancel</a>
		</div>
	</div>
</form>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
