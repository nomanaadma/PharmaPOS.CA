@{
    ViewData["Title"] = ViewData["page_title"] ?? "Reports";
}

<div class="page-title">
    <div class="row align-items-center">
        <div class="col-sm-4">
            <h2 class="page-title-text d-inline-block">@ViewData["Title"]</h2>
            <div class="breadcrumbs d-inline-block">
                <ul>
                    <li><a href="/">Dashboard</a></li>
                    <li>@ViewData["Title"]</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="row text-center">
    <div class="col-md-3">
        <div class="panel panel-default">
            <div class="panel-body">
                <i class="las la-cart-plus font-36 text-success"></i>
                <h3 class="mb-4">POS/Bill Report</h3>
                <a asp-controller="Medicine" asp-action="Billing" class="btn btn-white btn-sm"><i class="las la-laptop"></i> View</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="panel panel-default">
            <div class="panel-body">
                <i class="las la-file-invoice-dollar font-36 text-info"></i>
                <h3 class="mb-4">Purchase Report</h3>
                <a asp-controller="Medicine" asp-action="Purchase" class="btn btn-white btn-sm"><i class="las la-laptop"></i> View</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="panel panel-default">
            <div class="panel-body">
                <i class="las la-pills font-36 text-twitter"></i>
                <h3 class="mb-4">Inventory Report</h3>
                <a asp-controller="Report" asp-action="Inventory" class="btn btn-white btn-sm"><i class="las la-laptop"></i> View</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="panel panel-default">
            <div class="panel-body">
                <i class="las la-coins font-36 text-facebook"></i>
                <h3 class="mb-4">Stats Report</h3>
                <a asp-controller="Report" asp-action="IncomeExpense" class="btn btn-white btn-sm"><i class="las la-laptop"></i> View</a>
            </div>
        </div>
    </div>
</div>
