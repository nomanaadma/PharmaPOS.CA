@{
	var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Dashboard";
	var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";

	string IsActive(string c, string? a = null)
	{
		var match = string.Equals(currentController, c, StringComparison.OrdinalIgnoreCase);
		
		if (match && a != null)
		{
			match = string.Equals(currentAction, a, StringComparison.OrdinalIgnoreCase);
		}
		
		return match ? "active" : "";
	}

	string[] IsHasSubActive(params string[] controllers)
	{
		var matchRoute = controllers.Any(c => string.Equals(currentController, c, StringComparison.OrdinalIgnoreCase));

		if (!matchRoute)
		{
			return ["", "", ""];
		}
		
		return
		[
			"active",
			"rotate",
			"style=\"display: block;\"",
		];
	}


}

<div class="menu-wrapper">
	<div class="menu">
		<ul>
			@if (User.HasPermission(Permissions.Dashboard.View))
			{
				<li class="@IsActive("Dashboard")">
					<a href="/"><i class="las la-chalkboard"></i><span>Dashboard</span></a>
				</li>
			}
			@if (User.HasPermission(Permissions.Customer.List))
			{
				<li class="@IsActive("Customer")">
					<a asp-controller="Customers" asp-action="Index">
						<i class="las la-user-md"></i>
						<span>Customers</span>
					</a>
				</li>
			}
			@if (User.HasPermission(Permissions.Billing.List))
			{
				<li class="@IsActive("Billing")">
					<a asp-controller="Billing" asp-action="Index">
						<i class="las la-cart-plus"></i>
						<span>POS/Bill</span>
					</a>
				</li>
			}
			@if (User.HasPermission(Permissions.Purchase.List))
			{
				<li class="@IsActive("Purchase")">
					<a asp-controller="Purchase" asp-action="Index">
						<i class="las la-file-invoice-dollar"></i>
						<span>Purchase</span>
					</a>
				</li>
			}
			@if (User.HasPermission(Permissions.Stock.View))
			{
				<li class="@IsActive("Stock")">
					<a asp-controller="Stock" asp-action="Index">
						<i class="las la-balance-scale"></i>
						<span>Stock adjustment</span>
					</a>
				</li>
			}

			@if (User.HasPermission(Permissions.Medicine.List))
			{
				<li class="@IsActive("Medicine")">
					<a asp-controller="Medicines" asp-action="Index">
						<i class="las la-pills"></i>
						<span>Medicines</span>
					</a>
				</li>
			}

			@if (User.HasPermission(Permissions.Reports.View))
			{
				<li class="@IsActive("Report")">
					<a asp-controller="Reports" asp-action="Index">
						<i class="las la-chalkboard-teacher"></i>
						<span>Report</span>
					</a>
				</li>
			}
			
			@if (User.HasPermission(Permissions.User.List))
			{
				var subActive = IsHasSubActive("User", "Role");
				
				<li class="has-sub @subActive[0]">
					<a><i class="las la-users"></i><span>Users</span><i class="arrow @subActive[1]"></i></a>
					<ul class="sub-menu" @Html.Raw(subActive[2])>
						<li class="@IsActive("User")"><a asp-controller="Users" asp-action="Index"><span>Users List</span></a></li>
						
						@if (User.IsInRole(Roles.Admin))
						{
							<li class="@IsActive("Role")"><a asp-controller="Roles" asp-action="Index"><span>User Role</span></a></li>
						}
					</ul>
				</li>
			}

			@{
				var canViewInfo = User.HasPermission(Permissions.Info.View);
				var canViewCategory = User.HasPermission(Permissions.Category.List);
				var canViewMethod = User.HasPermission(Permissions.PaymentMethod.List);
				var canViewSupplier = User.HasPermission(Permissions.Suppliers.List);
			}
			
			@if (canViewInfo || canViewCategory || canViewMethod || canViewSupplier)
			{
				var subActive = IsHasSubActive("Setting", "Category", "PaymentMethod", "Supplier");
				
				<li class="has-sub @subActive[0]">
					<a><i class="las la-cog"></i><span>Setting</span><i class="arrow @subActive[1]"></i></a>
					<ul class="sub-menu" @Html.Raw(subActive[2])>
						@if(canViewInfo) {
							<li class="@IsActive("Setting", "Index")"><a asp-controller="Setting" asp-action="Index"><span>System Info</span></a></li>
						}
						
						@if(canViewCategory) {
							<li class="@IsActive("Category")"><a asp-controller="Categories" asp-action="Index"><span>Medicine Category</span></a></li>
						}
						
						@if(canViewMethod) {
							<li class="@IsActive("PaymentMethod")"><a asp-controller="PaymentMethods" asp-action="Index"><span>Payment Methods</span></a></li>
						}
						
						@if(canViewSupplier) {
							<li class="@IsActive("Supplier")"><a asp-controller="Suppliers" asp-action="Index"><span>Suppliers</span></a></li>
						}
					</ul>
				</li>
			}
			
			<li>
				<form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/">
					<button id="logout" type="submit" class="nav-link btn btn-link text-dark border-0">Logout</button>
				</form>

				<a class="logout-link" href="javascript:void(0);">
					<i class="las la-sign-out-alt"></i>
					<span>Logout</span>
				</a>

			</li>
		</ul>
	</div>
</div>