<div class="menu-wrapper">
	<div class="menu">
		<ul>
			@if (User.HasPermission(Permissions.Dashboard.View))
			{
				<li>
					<a href="/"><i class="las la-chalkboard"></i><span>Dashboard</span></a>
				</li>
			}
			@if (User.HasPermission(Permissions.Customer.List))
			{
				<li>
					<a asp-controller="Customer" asp-action="Index">
						<i class="las la-user-md"></i>
						<span>Customers</span>
					</a>
				</li>
			}
			@if (User.HasPermission(Permissions.Billing.List))
			{
				<li>
					<a asp-controller="Billing" asp-action="Index">
						<i class="las la-cart-plus"></i>
						<span>POS/Bill</span>
					</a>
				</li>
			}
			@if (User.HasPermission(Permissions.Purchase.List))
			{
				<li>
					<a asp-controller="Purchase" asp-action="Index">
						<i class="las la-file-invoice-dollar"></i>
						<span>Purchase</span>
					</a>
				</li>
			}
			@if (User.HasPermission(Permissions.Stock.View))
			{
				<li>
					<a asp-controller="Stock" asp-action="Index">
						<i class="las la-balance-scale"></i>
						<span>Stock adjustment</span>
					</a>
				</li>
			}

			@if (User.HasPermission(Permissions.Medicine.List))
			{
				<li>
					<a asp-controller="Medicine" asp-action="Index">
						<i class="las la-pills"></i>
						<span>Medicines</span>
					</a>
				</li>
			}

			@if (User.HasPermission(Permissions.Reports.View))
			{
				<li>
					<a asp-controller="Report" asp-action="Index">
						<i class="las la-chalkboard-teacher"></i>
						<span>Report</span>
					</a>
				</li>
			}
			
			@if (User.HasPermission(Permissions.User.List))
			{
				<li class="has-sub">
					<a><i class="las la-users"></i><span>Users</span><i class="arrow"></i></a>
					<ul class="sub-menu">
						<li><a asp-controller="User" asp-action="Index"><span>Users List</span></a></li>
						
						@if (User.IsInRole(Roles.Admin))
						{
							<li><a asp-controller="Role" asp-action="Index"><span>User Role</span></a></li>
						}
					</ul>
				</li>
			}

			@{
				var canViewInfo = User.HasPermission(Permissions.Info.View);
				var canViewCategory = User.HasPermission(Permissions.Category.List);
				var canViewMethod = User.HasPermission(Permissions.PaymentMethod.List);
				var canViewSupplier = User.HasPermission(Permissions.Suppliers.List);
			}
			
			@if (canViewInfo || canViewCategory || canViewMethod || canViewSupplier)
			{
				
				<li class="has-sub">
					<a><i class="las la-cog"></i><span>Setting</span><i class="arrow"></i></a>
					<ul class="sub-menu">
						@if(canViewInfo) {
							<li><a asp-controller="Setting" asp-action="Index"><span>System Info</span></a></li>
						}
						
						@if(canViewCategory) {
							<li><a asp-controller="Setting" asp-action="Categories"><span>Medicine Category</span></a></li>
						}
						
						@if(canViewMethod) {
							<li><a asp-controller="Setting" asp-action="PaymentMethods"><span>Payment Methods</span></a></li>
						}
						
						@if(canViewSupplier) {
							<li><a asp-controller="Setting" asp-action="Suppliers"><span>Suppliers</span></a></li>
						}
					</ul>
				</li>
			}
			
			<li>
				<form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/">
					<button id="logout" type="submit" class="nav-link btn btn-link text-dark border-0">Logout</button>
				</form>

				<a class="logout-link" href="javascript:void(0);">
					<i class="las la-sign-out-alt"></i>
					<span>Logout</span>
				</a>

			</li>
		</ul>
	</div>
</div>