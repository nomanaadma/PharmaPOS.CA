@using PharmaPOS.Domain.Enums
@model PharmaPOS_MVC.Models.PaymentMethodViewModel
@{
	var isEdit = Model?.Id.HasValue ?? false;
	var pageType = isEdit ? "Edit" : "Add";
	
	var pageTitle = pageType + " Payment Method";
	ViewData["Title"] = pageTitle;

}

<div class="page-title">
	<div class="row align-items-center">
		<div class="col-sm-12">
			<h2 class="page-title-text d-inline-block">@ViewData["Title"]</h2>
			<partial name="Partials/_Breadcrumb" model='new BreadcrumbItem[] { 
				new("Payment Methods", Url.Action("Index", "PaymentMethods")),
				new(pageTitle) 
			}' />
		</div>
	</div>
</div>

<form  asp-action="@pageType" method="post">
	@Html.AntiForgeryToken()
	@if (isEdit)
	{
		<input type="hidden" asp-for="Id" />
	}
	<div class="panel panel-default">
		<div class="panel-body">
			<div class="row">
				<div class="col-md-6">
					<div class="form-group">
						<label class="col-form-label">Payment Method Name <span class="form-required">*</span></label>
						<input type="text" asp-for="Name" class="form-control" placeholder="Enter Payment Method Name . . ." required>
						<span asp-validation-for="Name" class="text-danger"></span>
					</div>
				</div>
				<div class="col-md-6">
					<div class="form-group">
						<label class="col-form-label">Status</label>
						<select asp-for="Status" class="custom-select" asp-items="Html.GetEnumSelectList<Status>()">
						</select>
						<span asp-validation-for="Status" class="text-danger"></span>
					</div>
				</div>
			</div>
		</div>
		<div class="panel-footer text-center">
			<button type="submit" class="btn btn-primary"><i class="las la-save pr-2"></i> Save</button>
			<a asp-controller="PaymentMethods" asp-action="Index" class="btn btn-secondary"><i class="las la-times pr-2"></i> Cancel</a>
		</div>
	</div>
</form>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
