@model PharmaPOS_MVC.Models.SystemInfoViewModel
@{
	ViewData["Title"] = "System Info";
}

<div class="page-title">
	<div class="row align-items-center">
		<div class="col-sm-12">
			<h2 class="page-title-text d-inline-block">@ViewData["Title"]</h2>
			<div class="breadcrumbs d-inline-block">
				<ul>
					<li><a href="/">Dashboard</a></li>
					<li>@ViewData["Title"]</li>
				</ul>
			</div>
		</div>
	</div>
</div>

<form asp-controller="Setting" asp-action="Index" method="post">
	@Html.AntiForgeryToken()
	<div class="panel panel-default">
		<div class="panel-body">
			<div class="tab-content pt-4">
				<div class="tab-pane active" id="setting-info">
					<div class="row">
						<div class="col-md-12">
							<div class="row pb-2">
								<!-- Logo -->
								<div class="col-md-3">
									<div class="form-group">
										<label class="d-block">Logo</label>
										<div class="image-upload" style="@(string.IsNullOrEmpty(Model.Logo) ? "" : "display:none")">
											<a>Upload</a>
										</div>
										<div class="saved-picture" style="@(string.IsNullOrEmpty(Model.Logo) ? "display:none" : "")">
											@if (!string.IsNullOrEmpty(Model.Logo))
											{
												<img class="img-thumbnail" src="~/uploads/@Model.Logo" alt="">
											}
											<input type="hidden" asp-for="Logo">
										</div>
										<div class="saved-picture-delete" data-toggle="tooltip" data-placement="right" title="Remove" style="@(string.IsNullOrEmpty(Model.Logo) ? "display:none" : "")">
											<a class="las la-trash-alt"></a>
										</div>
									</div>
								</div>

								<!-- Logo Icon -->
								<div class="col-md-3">
									<div class="form-group">
										<label class="d-block">Logo Icon</label>
										<div class="image-upload" style="@(string.IsNullOrEmpty(Model.LogoIcon) ? "" : "display:none")">
											<a>Upload</a>
										</div>
										<div class="saved-picture" style="@(string.IsNullOrEmpty(Model.LogoIcon) ? "display:none" : "")">
											@if (!string.IsNullOrEmpty(Model.LogoIcon))
											{
												<img class="img-thumbnail" src="/uploads/@Model.LogoIcon" alt="">
											}
											<input type="hidden" asp-for="LogoIcon">
										</div>
										<div class="saved-picture-delete" data-toggle="tooltip" data-placement="right" title="Remove" style="@(string.IsNullOrEmpty(Model.LogoIcon) ? "display:none" : "")">
											<a class="las la-trash-alt"></a>
										</div>
									</div>
								</div>

								<!-- Login Background -->
								<div class="col-md-3">
									<div class="form-group">
										<label class="d-block">Login background</label>
										<div class="image-upload" style="@(string.IsNullOrEmpty(Model.LgBackground) ? "" : "display:none")">
											<a>Upload</a>
										</div>
										<div class="saved-picture" style="@(string.IsNullOrEmpty(Model.LgBackground) ? "display:none" : "")">
											@if (!string.IsNullOrEmpty(Model.LgBackground))
											{
												<img class="img-thumbnail" src="/uploads/@Model.LgBackground" alt="">
											}
											<input type="hidden" asp-for="LgBackground">
										</div>
										<div class="saved-picture-delete" data-toggle="tooltip" data-placement="right" title="Remove" style="@(string.IsNullOrEmpty(Model.LgBackground) ? "display:none" : "")">
											<a class="las la-trash-alt"></a>
										</div>
									</div>
								</div>

								<!-- Favicon -->
								<div class="col-md-3">
									<div class="form-group">
										<label class="d-block">Favicon</label>
										<div class="image-upload" style="@(string.IsNullOrEmpty(Model.Favicon) ? "" : "display:none")">
											<a>Upload</a>
										</div>
										<div class="saved-picture" style="@(string.IsNullOrEmpty(Model.Favicon) ? "display:none" : "")">
											@if (!string.IsNullOrEmpty(Model.Favicon))
											{
												<img class="img-thumbnail" src="/uploads/@Model.Favicon" alt="">
											}
											<input type="hidden" asp-for="Favicon">
										</div>
										<div class="saved-picture-delete" data-toggle="tooltip" data-placement="right" title="Remove" style="@(string.IsNullOrEmpty(Model.Favicon) ? "display:none" : "")">
											<a class="las la-trash-alt"></a>
										</div>
									</div>
								</div>
							</div>
						</div>

						<div class="col-md-6">
							<div class="form-group">
								<label>Store Name <span class="form-required">*</span></label>
								<div class="input-group">
									<div class="input-group-prepend">
										<span class="input-group-text"><i class="las la-tag"></i></span>
									</div>
									<input type="text" asp-for="Name" class="form-control" placeholder="Enter Store Name . . ." required>
								</div>
								<span asp-validation-for="Name" class="text-danger"></span>
							</div>
							<div class="form-group">
								<label>Store Legal Name <span class="form-required">*</span></label>
								<div class="input-group">
									<div class="input-group-prepend">
										<span class="input-group-text"><i class="las la-id-badge"></i></span>
									</div>
									<input type="text" asp-for="LegalName" class="form-control" placeholder="Enter Store Legal Name . . ." required>
								</div>
								<span asp-validation-for="LegalName" class="text-danger"></span>
							</div>
						</div>

						<div class="col-md-6">
							<div class="form-group">
								<label>Email Address <span class="form-required">*</span></label>
								<div class="input-group">
									<div class="input-group-prepend">
										<span class="input-group-text"><i class="las la-envelope"></i></span>
									</div>
									<input type="email" asp-for="Mail" class="form-control" placeholder="Enter Email Address . . ." required>
								</div>
								<span asp-validation-for="Mail" class="text-danger"></span>
							</div>
							<div class="form-group">
								<label>Phone Number <span class="form-required">*</span></label>
								<div class="input-group">
									<div class="input-group-prepend">
										<span class="input-group-text"><i class="las la-mobile"></i></span>
									</div>
									<input type="text" asp-for="Phone" class="form-control" placeholder="Enter Phone Number . . ." required>
								</div>
								<span asp-validation-for="Phone" class="text-danger"></span>
							</div>
						</div>
					</div>

					<div class="row">
						<div class="col-md-3">
							<div class="form-group">
								<label>Address Line 1</label>
								<div class="input-group">
									<div class="input-group-prepend">
										<span class="input-group-text"><i class="las la-map-pin"></i></span>
									</div>
									<input type="text" asp-for="AddressLine1" class="form-control" placeholder="Enter Address Line 1 . . .">
								</div>
							</div>
						</div>
						<div class="col-md-3">
							<div class="form-group">
								<label>Address Line 2</label>
								<div class="input-group">
									<div class="input-group-prepend">
										<span class="input-group-text"><i class="las la-map-pin"></i></span>
									</div>
									<input type="text" asp-for="AddressLine2" class="form-control" placeholder="Enter Address Line 2 . . .">
								</div>
							</div>
						</div>
						<div class="col-md-6">
							<div class="form-group">
								<label>City</label>
								<div class="input-group">
									<div class="input-group-prepend">
										<span class="input-group-text"><i class="las la-map-signs"></i></span>
									</div>
									<input type="text" asp-for="City" class="form-control" placeholder="Enter City . . .">
								</div>
							</div>
						</div>
						<div class="col-md-6">
							<div class="form-group">
								<label>Country</label>
								<div class="input-group">
									<div class="input-group-prepend">
										<span class="input-group-text"><i class="las la-map-marker"></i></span>
									</div>
									<input type="text" asp-for="Country" class="form-control" placeholder="Enter Country . . .">
								</div>
							</div>
						</div>
						<div class="col-md-6">
							<div class="form-group">
								<label>Postal/ZIP Code</label>
								<div class="input-group">
									<div class="input-group-prepend">
										<span class="input-group-text"><i class="las la-map"></i></span>
									</div>
									<input type="text" asp-for="Postal" class="form-control" placeholder="Enter Postal/ZIP Code . . .">
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="panel-footer text-center">
			<button type="submit" name="submit" class="btn btn-primary"><i class="las la-save pr-2"></i> Save</button>
		</div>
	</div>
</form>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
