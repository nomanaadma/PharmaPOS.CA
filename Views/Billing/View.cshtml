@model PharmaPOS_MVC.Domain.Entities.MedicineBill
@{
	ViewData["Title"] = "Bill Invoice";
}

<div class="page-title">
	<div class="row align-items-center">
		<div class="col-sm-7">
			<h2 class="page-title-text d-inline-block">@ViewData["Title"]</h2>
			<div class="breadcrumbs d-inline-block">
				<ul>
					<li><a href="/">Dashboard</a></li>
					<li><a asp-controller="Billing" asp-action="Index">Billing</a></li>
					<li>@ViewData["Title"]</li>
				</ul>
			</div>
		</div>
		<div class="col-sm-5 text-right">
			<a
				asp-controller="Billing"
				asp-action="Edit"
				asp-route-id="@Model.Id"
				class="btn btn-primary btn-sm"><i class="las la-edit mr-2"></i>Edit</a>
		</div>
	</div>
</div>
<div class="inv-template mb-4">
	<div class="inv-template-bdy table-responsive p-4">
		<div class="meta table-responsive" style="border-top: 0">
			<table>
				<tbody>
					<tr>
						<td class="bill-to v-aling-bottom">
							<div class="heading">Customer</div>
							<div class="title">@Model.Name</div>
							<div class="text">@Model.Email</div>
							<div class="text">@Model.Mobile</div>
						</td>
						<td class="info v-aling-bottom">
							<table class="text-right">
								<tbody>
									<tr>
										<td class="text">#</td>
										<td class="text w-min-130">@Model.Id.ToString("D5")</td>
									</tr>
									<tr>
										<td class="text">Bill Date</td>
										<td class="text w-min-130">@Model.BillDate.ToString("dd/MM/yyyy")</td>
									</tr>
									<tr>
										<td class="text">Payment Method</td>
										<td class="text w-min-130">@Model.PaymentMethod?.Name</td>
									</tr>
								</tbody>
							</table>
						</td>
					</tr>
				</tbody>
			</table>
		</div>
		<div class="item table-responsive">
			<table>
				<thead>
					<tr>
						<th>Name</th>
						<th>BatchNo</th>
						<th>ExpiryDate</th>
						<th>Quantity</th>
						<th>SalePrice</th>
						<th>Gross</th>
						<th>Discount</th>
						<th>Tax</th>
						<th>Price</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var value in Model.Items)
					{
						<tr>
							<td>@value.Medicine.Name</td>
							<td>@value.Batch.Batch</td>
							<td>@(DateTime.TryParse(value.Batch.Expiry, out var date) ? date.ToString("MM-yyyy") : value.Batch.Expiry)</td>
							<td>@value.Qty</td>
							<td>@value.SalePrice</td>
							<td>@value.Gross</td>
							<td>@value.DiscountValue</td>
							<td>@value.TaxPrice</td>
							<td>@value.Price</td>
						</tr>
					}
					<tr class="total">
						<td rowspan="5" colspan="5" class="blank">
						</td>
						<td class="title" colspan="2">Sub Total</td>
						<td class="value" colspan="2">Rs @Model.Subtotal</td>
					</tr>
					<tr class="total">
						<td class="title" colspan="2">Tax</td>
						<td class="value" colspan="2">Rs @Model.Tax</td>
					</tr>
					<tr class="total">
						<td class="title" colspan="2">Discount</td>
						<td class="value" colspan="2">Rs @Model.DiscountValue</td>
					</tr>
					<tr class="total">
						<td class="title" colspan="2">Amount</td>
						<td class="value" colspan="2">Rs @Model.Amount</td>
					</tr>
				</tbody>
			</table>
		</div>
		<div class="note">
			<table>
				<tbody>
					<tr>
						<td class="block align-top">
							<span>Note</span>
							<p>@Model.Note</p>
						</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>
</div>
