@model PharmaPOS_MVC.Models.BillingFormModel
@{
	var isEdit = Model?.Id.HasValue ?? false;
	var pageType = isEdit ? "Edit" : "New";
	ViewData["Title"] = pageType + " Bill";
}

<div class="page-title">
	<div class="row align-items-center">
		<div class="col-sm-12">
			<h2 class="page-title-text d-inline-block">@ViewData["Title"]</h2>
			<div class="breadcrumbs d-inline-block">
				<ul>
					<li><a href="/">Dashboard</a></li>
					<li><a asp-controller="Billing" asp-action="Index">Billing</a></li>
					<li>@ViewData["Title"]</li>
				</ul>
			</div>
		</div>
	</div>
</div>

<form method="post" class="billing_form">
	
	<div asp-validation-summary="All" class="text-danger"></div>

	<input type="hidden" name="billing[Id]" value="@Model?.Id" />

	<div class="panel panel-default">
		<div class="panel-body">
			<div class="row">
				<div class="col-md-6">
					<div class="form-group">
						<label>Customer Name <span class="form-required">*</span></label>
						<div class="input-group">
							<div class="input-group-prepend"><span class="input-group-text"><i class="las la-user"></i></span></div>
							<input type="text" name="billing[Name]" value="@Model?.Name" class="form-control customer-name" placeholder="Customer Name" required />
							<input type="hidden" name="billing[CustomerId]" value="@Model?.CustomerId" class="customer-id" />
						</div>
					</div>
					<div class="form-group">
						<label>Customer Email</label>
						<div class="input-group">
							<div class="input-group-prepend"><span class="input-group-text"><i class="las la-envelope"></i></span></div>
							<input type="email" name="billing[Email]" value="@Model?.Email" class="form-control customer-email" placeholder="Customer Email" />
						</div>
					</div>
					<div class="form-group">
						<label>Customer Mobile</label>
						<div class="input-group">
							<div class="input-group-prepend"><span class="input-group-text"><i class="las la-phone"></i></span></div>
							<input type="text" name="billing[Mobile]" value="@Model?.Mobile" class="form-control customer-mobile" placeholder="Customer Mobile" />
						</div>
					</div>
				</div>
				<div class="col-md-6">
					<div class="form-group">
						<label>Payment Method <span class="form-required">*</span></label>
						<div class="input-group">
							<div class="input-group-prepend"><span class="input-group-text"><i class="las la-money-bill"></i></span></div>
							<select name="billing[Method]" class="custom-select" required>
								<option value="">Select Method</option>
								@if (Model?.PaymentMethods != null)
								{
									foreach (var method in Model.PaymentMethods)
									{
										if (Model.Method.ToString() == method.Value)
										{
											<option value="@method.Value" selected>@method.Text</option>
										}
										else
										{
											<option value="@method.Value">@method.Text</option>
										}
									}
								}
							</select>
						</div>
					</div>
					<div class="form-group">
						<label>Bill Date <span class="form-required">*</span></label>
						<div class="input-group">
							<div class="input-group-prepend"><span class="input-group-text"><i class="las la-calendar-alt"></i></span></div>
							<input name="billing[BillDate]" value="@(Model?.BillDate.ToString("yyyy-MM-dd"))" type="date" class="form-control bg-white" required />
						</div>
					</div>
					<div class="form-group">
						<label>Note</label>
						<div class="input-group">
							<div class="input-group-prepend"><span class="input-group-text"><i class="las la-paragraph"></i></span></div>
							<textarea name="billing[Note]" class="form-control" placeholder="Enter Note or Comment . . .">@Model?.Note</textarea>
						</div>
					</div>
				</div>
			</div>
			
			<div class="billing-items">
				<table class="table table-input">
					<thead>
						<tr>
							<th>Name<span class="form-required">*</span></th>
							<th>Batch No<span class="form-required">*</span></th>
							<th>Expiry Date<span class="form-required">*</span></th>
							<th>Quantity<span class="form-required">*</span></th>
							<th>Sale Price<span class="form-required">*</span></th>
							<th>Gross</th>
							<th>Discount</th>
							<th>Tax</th>
							<th>Price<span class="form-required">*</span></th>
							<th></th>
						</tr>
					</thead>
					<tbody>
					@if (Model != null && Model.Items.Any())
					{
						for (var i = 0; i < Model.Items.Count; i++)
						{
							<tr class="item-row">
								<td>
									<input type="text" name="billing[Items][@i][Name]" value="@Model.Items[i].Name" class="form-control item-name" required />
									<input type="hidden" name="billing[Items][@i][MedicineId]" value="@Model.Items[i].MedicineId" class="item-medicine-id" />
								</td>
								<td>
									<select name="billing[Items][@i][Batch]" class="custom-select item-batch" required>
										<option value="@Model.Items[i].Batch">@Model.Items[i].BatchName</option>
									</select>
									<input type="hidden" name="billing[Items][@i][BatchName]" value="@Model.Items[i].BatchName" class="item-batch-name" />
								</td>
								<td>
									<input type="text" name="billing[Items][@i][Expiry]" value="@Model.Items[i].Expiry" class="form-control item-expiry bg-white" required readonly />
								</td>
								<td>
									<div class="input-group">
										<input type="text" name="billing[Items][@i][Qty]" value="@Model.Items[i].Qty" class="form-control item-qty" required />
										<div class="input-group-prepend"><span class="item-available-qty input-group-text">0</span></div>
									</div>
								</td>
								<td>
									<input type="text" name="billing[Items][@i][Saleprice]" value="@Model.Items[i].Saleprice" class="form-control item-sale" required />
								</td>
								<td>
									<input type="text" name="billing[Items][@i][Gross]" value="@Model.Items[i].Gross" class="item-gross" readonly />
								</td>
								<td>
									<div class="row no-gutters">
										<div class="col">
											<select name="billing[Items][@i][Discounttype]" class="custom-select border-light item-discounttype">
												@if (Model.Items[i].Discounttype == 1) {
													<option value="1" selected>%</option>
													<option value="2">Flat</option>
												} else {
													<option value="1">%</option>
													<option value="2" selected>Flat</option>
												}
											</select>
										</div>
										<div class="col">
											<textarea name="billing[Items][@i][Discount]" class="item-discount">@Model.Items[i].Discount</textarea>
											<input type="text" name="billing[Items][@i][Discountvalue]" value="@Model.Items[i].Discountvalue" class="item-discountvalue" readonly />
										</div>
									</div>
								</td>
								<td class="invoice-tax">
									<input type="text" name="billing[Items][@i][Tax]" value="@Model.Items[i].Tax" class="item-tax" />
									<input type="text" name="billing[Items][@i][Taxprice]" value="@Model.Items[i].Taxprice" class="item-taxprice" readonly />
								</td>
								<td>
									<input type="text" name="billing[Items][@i][Price]" value="@Model.Items[i].Price" class="form-control bg-white item-price" required readonly />
								</td>
								<td>
									<a class="badge badge-danger badge-sm badge-pill delete m-1">Delete</a>
								</td>
							</tr>
						}
					}
					</tbody>
				</table>
				<div class="mt-3">
					<a class="btn btn-secondary btn-sm add-items"><i class="las la-plus"></i> Add Item</a>
				</div>
			</div>
			
			<div class="row mt-4">
				<div class="col-md-6 offset-md-6">
					<table class="table table-bordered">
						<tbody>
							<tr>
								<td width="50%" class="text-right"><strong>Subtotal:</strong></td>
								<td><input type="text" name="billing[Subtotal]" value="@Model?.Subtotal" class="form-control total-price bg-white" readonly /></td>
							</tr>
							<tr>
								<td class="text-right"><strong>Tax:</strong></td>
								<td><input type="text" name="billing[Tax]" value="@Model?.Tax" class="form-control total-tax bg-white" readonly /></td>
							</tr>
							<tr>
								<td class="text-right"><strong>Discount:</strong></td>
								<td><input type="text" name="billing[DiscountValue]" value="@Model?.DiscountValue" class="form-control total-discount bg-white" readonly /></td>
							</tr>
							<tr>
								<td class="text-right"><strong>Total Amount:</strong></td>
								<td><input type="text" name="billing[Amount]" value="@Model?.Amount" class="form-control total-amount bg-white" readonly /></td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
			
		</div>
		<div class="panel-footer text-right">
			<a asp-controller="Billing" asp-action="Index" class="btn btn-secondary">Cancel</a>
			<button type="submit" class="btn btn-primary">Save Bill</button>
		</div>
	</div>
</form>

@section Scripts {
	<script type="text/javascript" src="~/js/billing.js"></script>
}
