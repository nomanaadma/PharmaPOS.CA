@model PharmaPOS_MVC.Models.BillingFormModel
@{
	var isEdit = Model?.Id.HasValue ?? false;
	ViewData["Title"] = isEdit ? "Edit" : "New" + " Bill";
	
	var actionType = isEdit ? "Edit" : "Add";
}

<div class="page-title">
	<div class="row align-items-center">
		<div class="col-sm-12">
			<h2 class="page-title-text d-inline-block">@ViewData["Title"]</h2>
			<div class="breadcrumbs d-inline-block">
				<ul>
					<li><a href="/">Dashboard</a></li>
					<li><a asp-controller="Billing" asp-action="Index">POS/Bill</a></li>
					<li>@ViewData["Title"]</li>
				</ul>
			</div>
		</div>
	</div>
</div>

<form method="post" class="billing_form" asp-action="@actionType">
	@Html.AntiForgeryToken()
	@if (isEdit)
	{
		<input type="hidden" asp-for="Id" />
	}
	
	<div class="panel panel-default">
		<div class="panel-body">
			<div class="row">
				<div class="col-md-6">
					<div class="form-group">
						<label>Name<span class="form-required">*</span></label>
						<div class="input-group">
							<div class="input-group-prepend"><span class="input-group-text"><i class="las la-user"></i></span></div>
							<input type="text" asp-for="Name" class="form-control customer-name" placeholder="Name">
							<input type="hidden" asp-for="CustomerId" class="customer-id">
						</div>
						<span asp-validation-for="Name" class="text-danger"></span>
					</div>
				</div>
				<div class="col-md-3">
					<div class="form-group">
						<label>Email Address</label>
						<div class="input-group">
							<div class="input-group-prepend"><span class="input-group-text"><i class="las la-envelope"></i></span></div>
							<input type="email" asp-for="Email" class="form-control customer-mail" placeholder="Email Address">
						</div>
						<span asp-validation-for="Email" class="text-danger"></span>
					</div>
				</div>
				<div class="col-md-3">
					<div class="form-group">
						<label>Mobile Number</label>
						<div class="input-group">
							<div class="input-group-prepend"><span class="input-group-text"><i class="las la-mobile"></i></span></div>
							<input type="text" asp-for="Mobile" class="form-control customer-mobile" placeholder="Mobile Number">
						</div>
						<span asp-validation-for="Mobile" class="text-danger"></span>
					</div>
				</div>
				<div class="col-md-3">
					<div class="form-group">
						<label>Date <span class="form-required">*</span></label>
						<div class="input-group">
							<div class="input-group-prepend"><span class="input-group-text"><i class="las la-calendar-alt"></i></span></div>
							<input asp-for="BillDate" type="text" class="form-control bg-white date" placeholder="Billing Date" readonly/>
						</div>
						<span asp-validation-for="BillDate" class="text-danger"></span>
					</div>
				</div>
				<div class="col-md-3">
					<div class="form-group">
						<label>Payment Method <span class="form-required">*</span></label>
						<div class="input-group">
							<div class="input-group-prepend"><span class="input-group-text"><i class="las la-credit-card"></i></span></div>
							<select asp-for="Method" asp-items="Model!.PaymentMethods" class="custom-select"></select>
						</div>
						<span asp-validation-for="PaymentMethods" class="text-danger"></span>
					</div>
				</div>
			</div>
			<div class="billing-items table-responsive mb-4">
				<table class="table table-input table-middle">
					<thead>
					<tr>
						<th>Name<span class="form-required">*</span></th>
						<th style="min-width: 100px;">Batch No<span class="form-required">*</span></th>
						<th>ExpiryDate<span class="form-required">*</span></th>
						<th>Qty * | Available Qty</th>
						<th>Sale Price<span class="form-required">*</span></th>
						<th>Gross</th>
						<th>Discount</th>
						<th>Tax</th>
						<th>Price<span class="form-required">*</span></th>
						<th></th>
					</tr>
					</thead>
					<tbody>
					@{
						decimal availableQuantity = 0;
					}
					@if (Model.Items.Any())
					{
						for (var i = 0; i < Model.Items.Count; i++)
						{

							<tr class="item-row">
								<td>
									<input type="text" asp-for="Items[i].Name" class="form-control item-name" required>
									<input type="hidden" asp-for="Items[i].MedicineId" class="form-control item-medicine-id" required>
								</td>
								<td >
									<select asp-for="Items[i].Batch" class="custom-select item-batch" required>
										<option value="">Select</option>
										@foreach (var batchf in Model.Items[i].Batches)
										{
											if (batchf.Id == Model.Items[i].Batch)
											{
												availableQuantity = batchf.Qty - batchf.Sold;
											}

											<option value="@batchf.Id">@batchf.Batch</option>
										}
									</select>
									<input type="hidden" asp-for="Items[i].BatchName" class="item-batch-name">
								</td>

								<td>
									<input type="text" asp-for="Items[i].Expiry" class="form-control item-expiry bg-white" required readonly>
								</td>
								<td>
									<div class="input-group">
										<input type="text" asp-for="Items[i].Qty" asp-format="{0:0.##}" class="form-control item-qty" required>
										<div class="input-group-prepend"><span class="item-available-qty input-group-text">@availableQuantity.ToZeroHash()</span></div>
									</div>
								</td>
								<td>
									<input type="text" asp-for="Items[i].Saleprice" class="form-control item-sale" required>
								</td>
								<td>
									<input type="text" readonly class="item-gross" asp-for="Items[i].Gross"/>
								</td>
								<td>
									<div class="row no-gutters">
										<div class="col">
											<select asp-for="Items[i].Discounttype" class="custom-select border-light item-discounttype">
												<option value="1">%</option>
												<option value="2">Flat</option>
											</select>
										</div>
									</div>
								</td>
								<td class="invoice-tax">
									<input type="text" asp-for="Items[i].Tax" class="item-tax">
									<input type="text" readonly asp-for="Items[i].Taxprice" class="item-taxprice">
								</td>
								<td>
									<input type="text" asp-for="Items[i].Price" asp-format="{0:0.##}" class="form-control bg-white item-price" required readonly>
								</td>
								<td>
									<a class="badge badge-danger badge-sm badge-pill delete m-1">Delete</a>
								</td>
							</tr>
						}
					}
					else
					{
						<tr class="item-row">
							<td>
								<input type="text" name="Items[0].Name" class="form-control item-name" required>
								<input type="hidden" name="Items[0].MedicineId" class="form-control item-medicine-id" required>
							</td>
							<td>
								<select name="Items[0].Batch" class="custom-select item-batch" required></select>
								<input type="hidden" name="Items[0].BatchName" class="item-batch-name">
							</td>
							<td>
								<input type="text" name="Items[0].Expiry" class="form-control item-expiry bg-white" required readonly>
							</td>
							<td>
								<div class="input-group">
									<input type="text" name="Items[0].Qty" class="form-control item-qty" required>
									<div class="input-group-prepend"><span class="item-available-qty input-group-text">0</span></div>
								</div>
							</td>
							<td>
								<input type="text" name="Items[0].Saleprice" class="form-control item-sale" required>
							</td>
							<td>
								<input type="text" readonly class="item-gross" name="Items[0].Gross"/>
							</td>
							<td class="">
								<div class="row no-gutters">
									<div class="col">
										<select name="Items[0].Discounttype" class="custom-select border-light item-discounttype">
											<option value="1">%</option>
											<option value="2">Flat</option>
										</select>
									</div>
									<div class="col">
										<textarea type="text" name="Items[0].Discount" class="item-discount">0</textarea>
										<input type="text" readonly name="Items[0].Discountvalue" class="item-discountvalue" value="0">
									</div>
								</div>
							</td>
							<td class="invoice-tax">
								<input type="text" name="Items[0].Tax" class="item-tax" value="0">
								<input type="text" readonly name="Items[0].Taxprice" class="item-taxprice" value="0">
							</td>
							<td>
								<input type="text" name="Items[0].Price" class="form-control bg-white item-price" required readonly>
							</td>
							<td>
								<a class="badge badge-danger badge-sm badge-pill delete m-1">Delete</a>
							</td>
						</tr>
					}
					<tr>
						<td colspan="10">
							<div class="add-items d-inline-block">
								<a class="btn btn-success btn-sm m-1"><i class="icon-plus mr-1"></i> Add Item</a>
							</div>
						</td>
					</tr>
					<tr>
						<td colspan="3" class="blank"></td>
						<td colspan="3" class="total-line"><label class="p-2">Sub Total</label></td>
						<td colspan="4" class="total-value">
							<input asp-for="Subtotal" type="text" class="form-transparent p-2 total-price" readonly/>
						</td>
					</tr>
					<tr>
						<td colspan="3" class="blank"></td>
						<td colspan="3" class="total-line"><label class="p-2">Discount</label></td>
						<td colspan="4" class="total-value">
							<input asp-for="DiscountValue" type="text" class="form-transparent p-2 total-discount" readonly/>
						</td>
					</tr>

					<tr>
						<td colspan="3" class="blank"></td>
						<td colspan="3" class="total-line"><label class="p-2">Tax</label></td>
						<td colspan="4" class="total-value">
							<input asp-for="Tax" type="text" class="form-transparent p-2 total-tax" readonly/>
						</td>
					</tr>

					<tr>
						<td colspan="3" class="blank"></td>
						<td colspan="3" class="total-line"><label class="p-2">Amount</label></td>
						<td colspan="4" class="total-value">
							<input asp-for="Amount" type="text" class="form-transparent p-2 total-amount" readonly/>
						</td>
					</tr>

					</tbody>
				</table>
			</div>
			<div class="row">
				<div class="col-md-6">
					<div class="form-group">
						<label>Note</label>
						<div class="input-group">
							<div class="input-group-prepend"><span class="input-group-text"><i class="las la-paragraph"></i></span></div>
							<textarea asp-for="Note" class="form-control" placeholder="Enter Note or Comment . . ."></textarea>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="panel-footer text-center">
			<button type="submit" name="submit" class="btn btn-primary"><i class="las la-save pr-2"></i> Save</button>
		</div>
	</div>
</form>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
	<script type="text/javascript" src="~/js/billing.js"></script>
}
