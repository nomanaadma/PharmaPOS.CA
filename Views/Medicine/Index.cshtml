@model IEnumerable<PharmaPOS_MVC.Models.MedicineViewModel>
@{
	ViewData["Title"] = "Medicines";
}

<div class="page-title">
	<div class="row align-items-center">
		<div class="col-sm-4">
			<h2 class="page-title-text d-inline-block">@ViewData["Title"]</h2>
			<div class="breadcrumbs d-inline-block">
				<ul>
					<li><a href="/">Dashboard</a></li>
					<li>@ViewData["Title"]</li>
				</ul>
			</div>
		</div>
		<div class="col-sm-8 text-right">
			<a class="btn btn-primary btn-sm" asp-controller="Medicine" asp-action="Add">
				<i class="las la-plus pr-2"></i> New Medicine
			</a>
		</div>
	</div>
</div>

<div class="panel panel-default">
	<div class="panel-body">
		<div class="table-responsive">
			<table class="table table-middle table-bordered table-striped datatable-table">
				<thead>
					<tr class="table-heading">
						<th>#</th>
						<th>Medicine</th>
						<th>Company</th>
						<th>Unit</th>
						<th>Unit/Packing</th>
						<th>Category</th>
						<th>Storebox</th>
						<th>Reorderlevel</th>
						<th>Live Stock</th>
						<th>Status</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					@{ var index = 1; }
					@foreach (var value in Model)
					{
						<tr>
							<td>@index</td>
							<td>
								<p class="m-0 text-primary">@value.Name</p>
								<p class="m-0 text-muted small">@value.Generic</p>
							</td>
							<td>@value.Company</td>
							<td>@value.Unit</td>
							<td>@value.UnitPacking</td>
							<td>@value.CategoryName</td>
							<td>@value.StoreBox</td>
							<td>@value.ReOrderLevel</td>
							<td>@value.LiveStock</td>
							<td>
								@if (value.MinLevel.HasValue && value.MinLevel.Value >= value.LiveStock)
								{
									<span class="badge badge-sm badge-danger">Minlevel</span>
								}
								else if (value.ReOrderLevel.HasValue && value.ReOrderLevel.Value >= value.LiveStock)
								{
									<span class="badge badge-sm badge-warning">Reorderlevel</span>
								}
								else
								{
									<span class="badge badge-sm badge-primary">Normal</span>
								}
							</td>
							<td class="table-action">

								<div class="dropdown d-inline-block">
									<a class="text-primary edit dropdown-toggle" data-toggle="dropdown"><i class="las la-ellipsis-h"></i></a>
									<ul class="dropdown-menu dropdown-menu-right">
										<li>
											<a
												asp-controller="Medicine"
												asp-action="View"
												asp-route-id="@value.Id"
											><i class="las la-laptop pr-2"></i>View</a>
										</li>
										<li>
											<a
												asp-controller="Medicine"
												asp-action="Edit"
												asp-route-id="@value.Id"
											><i class="las la-edit pr-2"></i>Edit</a>
										</li>	
									</ul>
								</div>

								<a class="table-delete text-danger delete" data-toggle="tooltip" title="Delete">
									<i class="las la-trash-alt"></i><input type="hidden" value="@value.Id">
								</a>

							</td>
						</tr>
						index++;
					}
				</tbody>
			</table>
		</div>
	</div>
</div>

<!-- DELETE MODAL -->
<div class="modal fade" id="delete-card" role="dialog">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Delete Medicine</h5>
				<button type="button" class="close" data-dismiss="modal" aria-label="Close">
					<span aria-hidden="true">&times;</span>
				</button>
			</div>
			<form asp-controller="Medicine" asp-action="Delete" method="post">
				@Html.AntiForgeryToken()
				<div class="modal-body">
					<p class="m-0">Are you sure you want to delete this medicine?</p>
					<div class="delete-card-button">
						<input type="hidden" name="id" class="delete-id">
					</div>
				</div>
				<div class="modal-footer text-center">
					<button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
					<button type="submit" class="btn btn-danger">Delete</button>
				</div>
			</form>
		</div>
	</div>
</div>
