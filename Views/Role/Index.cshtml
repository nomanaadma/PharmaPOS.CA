@model IEnumerable<PharmaPOS_MVC.Models.RoleListViewModel>
@{
	const string pageTitle = "User Roles";
	ViewData["Title"] = pageTitle;
}

<div class="page-title">
	<div class="row align-items-center">
		<div class="col-sm-4">
			<h2 class="page-title-text d-inline-block">@ViewData["Title"]</h2>
			<partial name="Partials/_Breadcrumb" model="new BreadcrumbItem[] { 
				new(pageTitle) 
			}" />
		</div>
		<div class="col-sm-8 text-right">
			<a asp-controller="Role" asp-action="Add" class="btn btn-primary btn-sm">
				<i class="las la-plus pr-2"></i> New User Role
			</a>
		</div>
	</div>
</div>

<div class="panel panel-default">
	<div class="panel-body">
		<div class="table-responsive">
			<table class="table table-bordered table-striped datatable-table" width="100%">
				<thead>
					<tr class="table-heading">
						<th>#</th>
						<th>Role Name</th>
						<th>Description</th>
						<th>Created Date</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					@{ var index = 1; }
					@foreach (var value in Model)
					{
						<tr>
							<td>@index</td>
							<td class="text-primary">@value.Name</td>
							<td>@value.Description</td>
							<td>@value.CreatedDate</td>
							<td class="table-action">
								@if (value.Name != Roles.Admin)
								{
									<a asp-controller="Role" asp-action="Edit" asp-route-id="@value.Id" class="text-primary edit" data-toggle="tooltip" title="Edit">
										<i class="las la-edit"></i>
									</a>
									<a class="table-delete text-danger delete" data-toggle="tooltip" title="Delete">
										<i class="las la-trash-alt"></i><input type="hidden" value="@value.Id">
									</a>
								}
							</td>
						</tr>
						index++;
					}
				</tbody>
			</table>
		</div>
	</div>
</div>

<!-- DELETE MODAL -->
<div class="modal fade" id="delete-card" role="dialog">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Delete User Role</h5>
				<button type="button" class="close" data-dismiss="modal" aria-label="Close">
					<span aria-hidden="true">&times;</span>
				</button>
			</div>
			<form asp-controller="Role" asp-action="Delete" method="post">
				@Html.AntiForgeryToken()
				<div class="modal-body">
					<p class="m-0">Are you sure you want to delete this user role?</p>
					<div class="delete-card-button">
						<input type="hidden" name="id" class="delete-id">
					</div>
				</div>
				<div class="modal-footer text-center">
					<button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
					<button type="submit" class="btn btn-danger">Delete</button>
				</div>
			</form>
		</div>
	</div>
</div>
