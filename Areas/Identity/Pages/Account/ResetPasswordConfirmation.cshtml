@page
@using PharmaPOS_MVC.Helper
@inject PharmaPOS_MVC.Data.ApplicationDbContext DbContext
@inject IWebHostEnvironment Env
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Reset Password Confirmation";
    var siteInfo = await SiteInfoHelper.GetSiteInfoAsync(DbContext, Env);
    ViewData["SiteInfo"] = siteInfo;
}

<div class="text-center mb-4">
	<p class="mb-0 font-12">Your password has been reset successfully.</p>
	<a asp-page="./Login" class="text-primary">Login Now</a>
</div>